{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!skills/install-anti-slop/assets"]
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"performance": {
				"noAccumulatingSpread": "error"
			}
		}
	},
	"markdown": {
		"formatter": {
			"enabled": false
		}
	}
}
